# the manual's screenshots (tools/manual_shots.sh copies them into docs/img): Foundry, from power-on
wait 3000
shot screen-intro.png
until section 1 20000
wait 5000
shot screen-verse.png
tap SEQ
wait 100
shot screen-drums.png
tap LFO
wait 100
shot screen-bass.png
tap ENV
wait 100
shot screen-guitar.png
tap ARP
wait 100
shot screen-synth.png
tap SEL
wait 100
shot screen-metal.png
tap FX
wait 100
shot screen-space.png
turn K2 2 80
wait 100
shot screen-turning.png
tap GLO
wait 100
shot screen-setup.png
tap HOME
wait 1500
shot screen-machine.png
press SAVE
wait 1000
shot screen-help.png
release SAVE
wait 300
# the quest: a breakdown, the build, the drop, a mute
until step 2 4000
tap REC
wait 50
shot screen-pending.png
until section 4 4000
wait 4000
shot screen-breakdown.png
tap REC
until section 2 4000
wait 3000
shot screen-build.png
until section 5 12000
wait 1500
shot screen-drop.png
press EDIT
tap ENV
release EDIT
wait 300
tap ENV
wait 1000
shot screen-muted.png
press EDIT
tap ENV
release EDIT
tap HOME
# a key: the root on its way
until step 3 4000
tapkey 6
wait 40
shot screen-root.png
# on through the song, shorter: a chorus, the outro
spin K2 1
until section 3 40000
wait 2500
shot screen-chorus.png
until section 6 200000
wait 3000
shot screen-outro.png
# the editors: the page's button again
tap HOME
wait 200
shot screen-song.png
turn SELECT 2
wait 1500
shot screen-chords.png
turn SELECT -2
tap SEQ
wait 200
tapkey b1
wait 1500
shot screen-edit-drums.png
tap LFO
wait 1500
shot screen-edit-bass.png
tap ENV
wait 1500
shot screen-edit-guitar.png
tap ARP
wait 1500
shot screen-edit-synth.png
tap SEL
wait 1500
shot screen-edit-metal.png
# a step held: its own knobs (this writes the song, and locks it)
tap LFO
wait 200
tapkey b4
key w9 down
wait 100
turn K2 1
wait 1500
shot screen-step.png
key w9 up
